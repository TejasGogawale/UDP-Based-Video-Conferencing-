# ---------------------------------------------------------------------------
# Frontend (Vercel / Vite). Set in Vercel -> Project -> Settings -> Environment
# Variables, then redeploy. Values are baked in at build time.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Backend (Flask on Render). Set in Render -> Service -> Environment.
# ---------------------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# Public URL of the frontend; used for the links inside invitation emails.
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated browser origins allowed to call the API.
# Leave unset to allow any origin (requests are authenticated by bearer token).
# CORS_ORIGINS=https://your-frontend.vercel.app

# --- Database ---------------------------------------------------------------
# REQUIRED in production. Without it the app uses a SQLite file that Render
# deletes on every deploy/restart (all accounts are lost).
# Use the "Internal Database URL" of a Render PostgreSQL instance, or any
# PostgreSQL URL (Neon, Supabase, ...). postgres:// and postgresql:// both work.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///vit_connect.db

# --- Email ------------------------------------------------------------------
# Render FREE web services block outbound SMTP (ports 25/465/587), so Gmail
# SMTP cannot work there. Use an HTTPS email API instead (either one):
#
#   Brevo  (https://www.brevo.com)  - free tier, can send from a verified
#                                     single sender such as your Gmail address.
#   Resend (https://resend.com)     - needs a verified domain to email anyone
#                                     other than yourself.
#
# EMAIL_PROVIDER: auto (default) | brevo | resend | smtp
# auto picks brevo, then resend, then smtp, based on which keys are present.
EMAIL_PROVIDER=auto
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# The sender address. Must be verified with the provider you use.
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=VIT Connect

# SMTP (works locally and on paid Render instances).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password

# --- WebRTC -----------------------------------------------------------------
# STUN alone cannot connect two people who are both behind strict NATs
# (most mobile networks). Add a TURN server for reliable calls.
# TURN_URLS is comma-separated; include a TCP/TLS URL for restrictive networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
