# Frontend (Vercel / Vite) Environment Variables
# Set these in your Vercel Project Settings -> Environment Variables when deployed:
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Backend (Flask / Python) Environment Variables
FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-secret-key
DATABASE_URL=sqlite:///vit_connect.db
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key
FRONTEND_URL=http://localhost:3000

# Google Mail (Gmail SMTP) Settings for automated meeting reminder emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
