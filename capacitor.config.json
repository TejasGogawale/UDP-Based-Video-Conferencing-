{
  "appId": "edu.vit.connect",
  "appName": "VIT Connect",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://udp-based-video-conferencing.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "udp-based-video-conferencing.vercel.app",
      "*.vercel.app",
      "*.onrender.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
